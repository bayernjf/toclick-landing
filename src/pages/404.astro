---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { localizePath } from '../i18n';

const lang = 'en' as const;
---

<BaseLayout lang={lang} title="404: Page Not Found | FlagBreaker">
  <Nav lang={lang} />
  <main class="mx-auto max-w-2xl px-4 py-32 text-center sm:px-6">
    <p class="font-mono text-sm uppercase tracking-wide text-brand-300">404</p>
    <h1 class="mt-4 text-3xl font-bold text-ink-50">This flag can't be found</h1>
    <p class="mt-3 text-ink-400">The page you're looking for doesn't exist or has been wiped.</p>
    <a href={localizePath('/', lang)} class="mt-8 inline-flex items-center justify-center rounded-lg bg-brand-500 px-6 py-3 text-sm font-medium text-white transition hover:bg-brand-600">Back to home</a>
  </main>
  <Footer lang={lang} />
</BaseLayout>
