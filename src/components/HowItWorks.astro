---
import { useTranslations, type Lang } from '../i18n';
import { stepsData } from '../data/features';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const steps = stepsData[lang];
---

<section id="how" aria-label={t('how.title')} class="border-t border-ink-800/60 py-20">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <div class="text-center">
      <h2 class="text-3xl font-bold text-ink-50 sm:text-4xl">{t('how.title')}</h2>
      <p class="mt-3 text-ink-400">{t('how.subtitle')}</p>
    </div>

    <ol class="mt-12 grid gap-5 md:grid-cols-3">
      {steps.map((s) => (
        <li class="relative rounded-xl border border-ink-800 bg-ink-900/60 p-6">
          <span class="absolute -top-3 left-6 inline-flex h-7 items-center rounded-full bg-brand-500 px-3 font-mono text-xs font-bold text-white">{s.num}</span>
          <h3 class="mt-3 text-lg font-semibold text-ink-50">{s.title}</h3>
          <p class="mt-2 text-sm leading-relaxed text-ink-300">{s.desc}</p>
        </li>
      ))}
    </ol>
  </div>
</section>
