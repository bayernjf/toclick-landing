---
import { useTranslations, localizePath, getAltLangPath, type Lang } from '../i18n';
import { SITE_NAME, SITE_NAME_EN, SOCIAL } from '../consts';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const brandName = lang === 'zh' ? SITE_NAME : SITE_NAME_EN;

const navItems = [
  { href: localizePath('/#personas', lang), label: t('nav.personas') },
  { href: localizePath('/#features', lang), label: t('nav.features') },
  { href: localizePath('/#how', lang), label: t('nav.how') },
  { href: localizePath('/#protection', lang), label: t('nav.protection') },
  { href: localizePath('/#faq', lang), label: t('nav.faq') },
];

const altLang = lang === 'zh' ? 'en' : 'zh';
const altLangHref = getAltLangPath(Astro.url.pathname, altLang);
---

<header class="sticky top-0 z-50 border-b border-ink-800/60 bg-ink-950/80 backdrop-blur-md">
  <nav class="mx-auto flex h-14 max-w-6xl items-center justify-between px-4 sm:px-6">
    <a href={localizePath('/', lang)} class="flex items-center gap-2 text-base font-semibold text-ink-50">
      <span class="inline-flex h-7 w-7 items-center justify-center rounded-md bg-brand-500 text-sm font-bold text-white">旗</span>
      <span>{brandName}</span>
    </a>

    <div class="hidden items-center gap-6 md:flex">
      {navItems.map((item) => (
        <a href={item.href} class="text-sm text-ink-300 transition hover:text-ink-50">{item.label}</a>
      ))}
    </div>

    <div class="flex items-center gap-3">
      <a href={altLangHref} class="rounded-md px-2 py-1 text-xs text-ink-400 transition hover:text-ink-100">
        {t('nav.langSwitch')}
      </a>
      <a
        href="https://bayjf.com"
        target="_blank"
        rel="noopener"
        class="hidden rounded-md px-2 py-1.5 text-xs text-ink-300 transition hover:text-ink-50 sm:inline-block"
      >BayJF</a>
      <a
        href={SOCIAL.github}
        target="_blank"
        rel="noopener"
        class="hidden rounded-md border border-ink-700 px-3 py-1.5 text-xs text-ink-200 transition hover:border-ink-500 hover:text-white sm:inline-block"
      >GitHub</a>
    </div>
  </nav>
</header>
