---
import { useTranslations, type Lang } from '../i18n';
import { featuresData } from '../data/features';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const features = featuresData[lang];
---

<section id="features" aria-label={t('features.title')} class="border-t border-ink-800/60 bg-ink-900/30 py-20">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <div class="text-center">
      <h2 class="text-3xl font-bold text-ink-50 sm:text-4xl">{t('features.title')}</h2>
      <p class="mt-3 text-ink-400">{t('features.subtitle')}</p>
    </div>

    <div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {features.map((f) => (
        <article class="rounded-xl border border-ink-800 bg-ink-900/60 p-5 transition hover:border-brand-500/40">
          <div class="text-2xl">{f.icon}</div>
          <h3 class="mt-3 text-base font-semibold text-ink-50">{f.title}</h3>
          <p class="mt-2 text-sm leading-relaxed text-ink-300">{f.desc}</p>
        </article>
      ))}
    </div>
  </div>
</section>
