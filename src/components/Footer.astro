---
import BayjfLink from '@bay/landing-ui/components/BayjfLink.astro';
import StarOnGithub from '@bay/landing-ui/components/StarOnGithub.astro';
import { useTranslations, localizePath, type Lang } from '../i18n';
import { SITE_NAME, SITE_NAME_EN, SOCIAL } from '../consts';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const year = new Date().getFullYear();
const brandName = lang === 'zh' ? SITE_NAME : SITE_NAME_EN;

const links = [
  { href: SOCIAL.docs, label: lang === 'zh' ? '文档' : 'Docs', external: true },
  { href: 'https://bayjf.com', label: 'BayJF', external: true },
  { href: SOCIAL.github, label: 'GitHub', external: true },
  { href: localizePath('/privacy', lang), label: lang === 'zh' ? '隐私政策' : 'Privacy' },
  { href: localizePath('/terms', lang), label: lang === 'zh' ? '服务条款' : 'Terms' },
];
---

<footer class="border-t border-ink-800/60 bg-ink-950">
  <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6">
    <div class="flex flex-col items-center justify-between gap-6 sm:flex-row">
      <div class="flex items-center gap-2">
        <svg viewBox="0 0 64 64" class="h-6 w-6" aria-hidden="true">
          <rect width="64" height="64" rx="14" fill="#ff9f43" />
          <path d="M20 14 L20 50 M20 14 L40 14 M20 30 L36 30" stroke="#fff" stroke-width="5" stroke-linecap="round" stroke-linejoin="round" fill="none" />
          <path d="M44 38 L52 46 L60 38" stroke="#fff" stroke-width="4" stroke-linecap="round" stroke-linejoin="round" fill="none" />
        </svg>
        <div>
          <p class="text-sm font-medium text-ink-100">{brandName}</p>
          <p class="text-xs text-ink-500">{t('footer.tagline')}</p>
        </div>
      </div>

      <nav class="flex flex-wrap items-center justify-center gap-5">
        {links.map((l) => (
          l.href === 'https://bayjf.com' ? (
            <BayjfLink size={16} class="text-xs text-ink-400 transition hover:text-ink-100" label={l.label} />
          ) : l.href === SOCIAL.github ? (
            <StarOnGithub href="https://github.com/bayernjf/toclick" size={14} class="text-ink-400" />
          ) : (
            <a href={l.href} target="_blank" rel="noopener" class="text-xs text-ink-400 transition hover:text-ink-100">{l.label}</a>
          )
        ))}
      </nav>
    </div>

    <div class="mt-8 border-t border-ink-800/50 pt-6 text-center">
      <p class="text-xs text-ink-500">© {year} {brandName}. {t('footer.rights')}</p>
    </div>
  </div>
</footer>
