---
import { useTranslations, localizePath, type Lang } from '../i18n';
import { SITE_NAME, SITE_NAME_EN, SOCIAL } from '../consts';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const year = new Date().getFullYear();
const brandName = lang === 'zh' ? SITE_NAME : SITE_NAME_EN;

const links = [
  { href: SOCIAL.github, label: 'GitHub', external: true },
  { href: SOCIAL.docs, label: lang === 'zh' ? '文档' : 'Docs', external: true },
  { href: SOCIAL.app, label: lang === 'zh' ? '打开 App' : 'Open App', external: true },
];
---

<footer class="border-t border-ink-800/60 bg-ink-950">
  <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6">
    <div class="flex flex-col items-center justify-between gap-6 sm:flex-row">
      <div class="flex items-center gap-2">
        <span class="inline-flex h-6 w-6 items-center justify-center rounded bg-brand-500 text-[10px] font-bold text-white">旗</span>
        <div>
          <p class="text-sm font-medium text-ink-100">{brandName}</p>
          <p class="text-xs text-ink-500">{t('footer.tagline')}</p>
        </div>
      </div>

      <nav class="flex flex-wrap items-center justify-center gap-5">
        {links.map((l) => (
          <a href={l.href} target="_blank" rel="noopener" class="text-xs text-ink-400 transition hover:text-ink-100">{l.label}</a>
        ))}
      </nav>
    </div>

    <div class="mt-8 border-t border-ink-800/50 pt-6 text-center">
      <p class="text-xs text-ink-500">© {year} {brandName}. {t('footer.rights')}</p>
    </div>
  </div>
</footer>
